---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import IndexRow from "../components/IndexRow.astro";
import Figure from "../components/Figure.astro";
import Button from "../components/Button.astro";
import { sites } from "../data/sites.js";

const rows = [
  { href: "/work/ptchwrk/", name: "Ptchwrk", year: "2026", description: "Embroidery studio platform", where: "ptchwrk.xyz" },
  ...sites.map((site) => ({
    href: `/work/sites/#${site.anchor}`,
    name: site.name,
    year: site.year,
    description: site.summary,
    where: site.text,
  })),
  { href: "#background", name: "Background", year: "", description: "School and work history", where: "" },
  { href: "#contact", name: "Contact", year: "", description: "Email, LinkedIn, GitHub", where: "" },
];

const work = [
  {
    name: "Ptchwrk",
    href: "/work/ptchwrk/",
    figure: "[Ptchwrk screenshot]",
    image: "ptchwrk",
    alt: "Ptchwrk's mockup editor: a round orange, cream and navy badge placed on the chest of a grey t-shirt, with placement and rotation tools above it.",
    paragraphs: [
      "A tool an embroidery studio uses to place artwork on garments, match colors to real thread, track thread stock and send quotes and invoices. Built alone, 2026 to now, for the General Wear studio.",
      "Under the hood: a canvas mockup editor, k-means palette extraction, CIEDE2000 color matching against Pantone and Madeira thread, AI background removal. React and Vite on Vercel, Flask and SQLite on AWS Lightsail, Cloudflare R2 for files, JWT auth.",
    ],
    link: { href: "https://ptchwrk.xyz", text: "ptchwrk.xyz" },
  },
];

const background = [
  { dates: "2026 to 2027", org: "Cornell Tech", rest: ", New York. MEng Computer Science." },
  { dates: "2024 to 2026", org: "Democracy at Work", rest: ", a nonprofit media organization. Chief Technology Officer." },
  { dates: "2023 to 2024", org: "Democracy at Work", rest: ". Creative Technology Specialist." },
  { dates: "to 2023", org: "Manhattan University", rest: ". Tutor and research scholar. BS Computer Science, 2023, Magna Cum Laude, Phi Beta Kappa." },
];
---

<Base
  title="Giorgi Samushia"
  description="Giorgi Samushia, full-stack developer in New York. MEng Computer Science at Cornell Tech. Ptchwrk, an embroidery studio platform, and websites for Brooklyn businesses."
>
  <header>
    <h1>Giorgi Samushia</h1>
    <p>Full-stack developer. MEng Computer Science at Cornell Tech, New York.</p>
    <p class="dim">[Intro]</p>
  </header>

  <nav class="index" aria-label="On this page">
    <div class="index-head">
      <span class="index-head-short">On this page</span>
      <span class="index-head-full" aria-hidden="true">Name</span>
      <span class="index-head-full" aria-hidden="true">Year</span>
      <span class="index-head-full" aria-hidden="true">What it is</span>
      <span class="index-head-full" aria-hidden="true">Where</span>
    </div>
    {rows.map((row) => <IndexRow {...row} />)}
  </nav>

  <section class="section" id="work">
    <SectionHeading>Work</SectionHeading>
    {work.map((entry) => (
      <article class="work-entry">
        <Figure label={entry.figure} image={entry.image} alt={entry.alt} />
        <div class="work-entry-body">
          <h3><a class="entry-name" href={entry.href}>{entry.name}</a></h3>
          <div class="work-entry-text">
            {entry.paragraphs.map((text) => <p>{text}</p>)}
            <p><a href={entry.link.href}>{entry.link.text}</a></p>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="section" id="sites">
    <SectionHeading>Sites</SectionHeading>
    <p>Websites for local businesses in Brooklyn.</p>
    <div class="sites">
      {sites.map((site) => (
        <article>
          <Figure kind="site" image={site.anchor} alt={site.alt} />
          <h3 class="site-name"><a class="entry-name" href={`/work/sites/#${site.anchor}`}>{site.name}</a></h3>
          <p>{site.line}</p>
          <p class="site-link"><a href={site.href}>{site.text}</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="background">
    <SectionHeading>Background</SectionHeading>
    <div class="timeline">
      {background.map((item) => (
        <>
          <span class="dim">{item.dates}</span>
          <p><strong>{item.org}</strong>{item.rest}</p>
        </>
      ))}
    </div>
  </section>

  <section class="section" id="contact">
    <SectionHeading>Contact</SectionHeading>
    <p class="dim">[Contact line]</p>
    <div class="buttons">
      <Button href="mailto:giorgisamu.gs@gmail.com">Email me</Button>
      <Button href="https://linkedin.com/in/giorgisamushia" quiet>LinkedIn</Button>
      <Button href="https://github.com/umasshia" quiet>GitHub</Button>
    </div>
  </section>
</Base>
