---
interface Props {
  href?: string;
  quiet?: boolean;
  type?: "button" | "submit";
}

const { href, quiet = false, type = "button" } = Astro.props;
const className = quiet ? "button button-quiet" : "button";
---

{href ? (
  <a class={className} href={href}><slot /></a>
) : (
  <button class={className} type={type}><slot /></button>
)}
